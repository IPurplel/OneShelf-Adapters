y.pl/katalog/rodzaj/epika/","href":"https://wolnelektury.pl/api/2/kinds/epika/","name":"Epika","slug":"epika"}],"children":[],"parent":"https://wolnelektury.pl/api/2/books/bajki-i-powiastki/","preview":false,"epub":"https://wolnelektury.pl/media/book/epub/tadeuszek.epub","mobi":"https://wolnelektury.pl/media/book/mobi/tadeuszek.mobi","pdf":"https://wolnelektury.pl/media/book/pdf/tadeuszek.pdf","html":"https://wolnelektury.pl/media/book/html/tadeuszek.html","txt":"https://wolnelektury.pl/media/book/txt/tadeuszek.txt","fb2":"https://wolnelektury.pl/media/book/fb2/tadeuszek.fb2","xml":"https://wolnelektury.pl/media/book/xml/tadeuszek.xml","cover_thumb":"https://wolnelektury.pl/media/book/cover_thumb/tadeuszek_c7pb7ge.jpg","cover":"https://wolnelektury.pl/media/book/cover/tadeuszek.jpg","isbn_pdf":null,"isbn_epub":null,"isbn_mobi":null,"abstract":"","has_mp3_file":false,"has_sync_file":false,"elevenreader_link":"https://elevenreader.io/audiobooks/wolnelektury:tadeuszek","content_warnings":[],"audiences":[],"changed_at":"2023-11-21T01:50:28.663137+01:00","read_time":150,"pages":0,"redakcja":"http://redakcja.wolnelektury.pl/documents/book/jachowicz-bajki-i-powiastki-tadeuszek/"},{"slug":"pan-tadeusz","title":"Pan Tadeusz, czyli ostatni zajazd na Litwie","full_sort_key":"mickiewicz adam$pan tadeusz czyli ostatni zajazd na litwie$1936","href":"https://wolnelektury.pl/api/2/books/pan-tadeusz/","url":"https://wolnelektury.pl/katalog/lektura/pan-tadeusz/","language":"pol","authors":[{"id":23,"url":"https://wolnelektury.pl/katalog/autor/adam-mickiewicz/","href":"https://wolnelektury.pl/api/2/authors/adam-mickiewicz/","name":"Adam Mickiewicz","slug":"adam-mickiewicz"}],"translators":[],"epochs":[{"id":24,"url":"https://wolnelektury.pl/katalog/epoka/romantyzm/","href":"https://wolnelektury.pl/api/2/epochs/romantyzm/","name":"Romantyzm","slug":"romantyzm"}],"genres":[{"id":9157,"url":"https://wolnelektury.pl/katalog/gatunek/epos/","href":"https://wolnelektury.pl/api/2/genres/epos/","name":"Epos","slug":"epos"}],"kinds":[{"id":31,"url":"https://wolnelektury.pl/katalog/rodzaj/epika/","href":"https://wolnelektury.pl/api/2/kinds/epika/","name":"Epika","slug":"epika"}],"children":[],"parent":null,"preview":false,"epub":"https://wolnelektury.pl/media/book/epub/pan-tadeusz.epub","mobi":"https://wolnelektury.pl/media/book/mobi/pan-tadeusz.mobi","pdf":"https://wolnelektury.pl/media/book/pdf/pan-tadeusz.pdf","html":"https://wolnelektury.pl/media/book/html/pan-tadeusz.html","txt":"https://wolnelektury.pl/media/book/txt/pan-tadeusz.txt","fb2":"https://wolnelektury.pl/media/book/fb2/pan-tadeusz.fb2","xml":"https://wolnelektury.pl/media/book/xml/pan-tadeusz.xml","cover_thumb":"https://wolnelektury.pl/media/book/cover_thumb/pan-tadeusz_aJXkd8P.jpg","cover":"https://wolnelektury.pl/media/book/cover/pan-tadeusz.jpg","isbn_pdf":"ISBN-978-83-288-0542-2","isbn_epub":"ISBN-978-83-288-3538-2","isbn_mobi":"ISBN-978-83-288-4624-1","abstract":"<p class=\"paragraph\"><em class=\"book-title\">Pan Tadeusz</em> Adama Mickiewicza stanowi spisaną trzynastozgłoskowcem (a więc stylem podniosłym), zawartą w dwunastu księgach epicką opowieść o szlachcie polskiej początku XIX wieku. Jako <em class=\"author-emphasis\">epopeja narodowa</em>, która miała „trafić pod strzechy”, czyli do wszystkich Polaków, również tych niezaliczających się do elit majątkowych, urzędniczych czy umysłowych — jest prawdopodobnie najsłynniejszym dziełem czołowego polskiego poety romantycznego.</p><p class=\"paragraph\">Wśród najważniejszych wątków fabularnych <em class=\"book-title\">Pana Tadeusza</em> wymienić należy: spór o zamek Horeszków, historię waśni Stolnika i Jacka Soplicy, wątek przemiany tego ostatniego z awanturnika w patriotę, uwieńczoną zaręczynami miłość Tadeusza i Zosi, romans młodzieńca z Telimeną, kobietą dojrzałą, spór Asesora z Rejentem o psy myśliwskie (Kusego i Sokoła), a przede wszystkim wątek niepodległościowy, związany z wojnami napoleońskimi i walką Polaków pod sztandarami Księstwa Warszawskiego z Rosją. W związku z tym wątkiem pojawiają się na kartach Pana Tadeusza postacie historyczne: generał Henryk Dąbrowski oraz generał Kniaziewicz.</p><p class=\"paragraph\">Mickiewicz pisał <em class=\"book-title\">Pana Tadeusza</em> w Paryżu, począwszy od 1832 roku; dzieło zostało opublikowane w 1834 roku i od razu zyskało niemałą popularność. Określenia „epopeja narodowa” po raz pierwszy użyto w odniesieniu do <em class=\"book-title\">Pana Tadeusza</em> w 1863 roku, po dwóch nieudanych zrywach niepodległościowych, i wiązało się to raczej z politycznym zapotrzebowaniem na utwór pełniący wobec Polaków funkcje analogiczne do eposu homeryckiego: opisujący zbiorowość wraz z jej wierzeniami i zwyczajami w decydującej chwili dziejowej. Gatunkowa przynależność dzieła jest jednak bardziej skomplikowana ze względu na wielość elementów odwołujących się do różnych wzorców, np. poematu heroicznego, sielanki, gawędy, satyry, powieści walterskotowskiej, gawędy szlacheckiej. </p><p class=\"paragraph\">Wśród inspiracji do powstania epopei o pełnym tytule: <em class=\"book-title\">Pan Tadeusz, czyli ostatni zajazd na Litwie</em> wymienić należy opowieści hrabiego Henryka Rzewuskiego, przyszłego autora <em class=\"book-title\">Pamiątek Soplicy</em>, do których spisania, dokładnie takim stylem, jakim operował, gdy je ze swadą opowiadał, budząc ducha dawnej Rzeczpospolitej Obojga Narodów — nakłonił Rzewuskiego Mickiewicz, który miał okazję słuchać magnata na jesieni 1830 roku w Rzymie, zanim jak grom spadła nań wieść o wybuchu powstania.</p><p class=\"paragraph\"><em class=\"book-title\">Pan Tadeusz</em>, jako utwór jednego z romantycznych wieszczów — jak w duchu epoki zwano wybitnych poetów, którym z racji działania w stanie natchnienia przypisywano zdolność przenikania tajemnic losów własnej zbiorowości, a nawet świata — niewątpliwie miał za zadanie podnieść na duchu Polaków po upadku powstania listopadowego i wyznaczyć im kierunek działania: zgodę narodową. Nawet w scenach pełnych przemocy czy dramatycznych Mickiewiczowska epopeja tchnie duchem harmonii i pogodą ducha. Fenomen ten przypisać należy zapewne zdolnościom twórczym Adama Mickiewicza, ale może również okolicznościom powstania utworu. </p><p class=\"paragraph\">Zaczyn dzieła powstał w 1831 roku, w zaciszu szlacheckiego dworku w Wielkopolsce, gdzie poeta znalazł gościnę, serdeczność, uznanie dla swego talentu i miłość Konstancji Łubieńskiej: wszystkie te ingrediencje składają się na sielankowy opis Soplicowa. Mickiewicz jechał wówczas do powstania, o którym wieść zaskoczyła go w trakcie europejskich wojaży; rwał się do boju, choć nie wierzył w możliwość powodzenia zrywu. Zatrzymał się, zachwycił polską atmosferą — i do powstania nie dołączył. Zapewne dobrze się stało, jeśli na rzecz patrzeć pod kątem dorobku kultury polskiej.</p><p class=\"paragraph\"><em class=\"book-title\">Pan Tadeusz</em> Adama Mickiewicza to lektura szkolna dla klas IV–VI (fragmenty) oraz klas VII–VIII (całość utworu) szkoły podstawowej. Ebook <em class=\"book-title\">Pan Tadeusz</em> zawiera przypisy opracowane specjalnie dla uczennic i uczniów. Audiobook <em class=\"book-title\">Pan Tadeusz</em> czyta Wiktor Korzeniewski.</p>","has_mp3_file":true,"has_sync_file":false,"elevenreader_link":"https://elevenreader.io/audiobooks/wolnelektury:pan-tadeusz","content_warnings":[],"audiences":["szkoła podstawowa"],"changed_at":"2026-09-09T11:25:03.797600+02:00","read_time":29117,"pages":334,"redakcja":"http://redakcja.wolnelektury.pl/documents/book/mickiewicz__pan_tadeusz/"},{"slug":"pamiatki-soplicy-tadeusz-rejten","title":"Tadeusz Rejten","full_sort_key":"rzewuski henryk$tadeusz rejten$2838","href":"https://wolnelektury.pl/api/2/books/pamiatki-soplicy-tadeusz-rejten/","url":"https://wolnelektury.pl/katalog/lektura/pamiatki-soplicy-tadeusz-rejten/","language":"pol","authors":[{"id":9452,"url":"https://wolnelektury.pl/katalog/autor/henryk-rzewuski/","href":"https://wolnelektury.pl/api/2/authors/henryk-r